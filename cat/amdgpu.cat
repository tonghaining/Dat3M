AMDGPU
(* AMDGPU Memory Model *)
(* Ported from vulkan.cat; availability-visibility chains retained.          *)
(* Reference: https://llvm.org/docs/AMDGPUMemoryModel.html                   *)

// Base relations (expected from the front-end):
// loc:       events accessing the same address
// swave:     same wavefront
// swg:       same workgroup
// scluster:  same cluster
// sagent:    same agent (device)
// ssw:       system-synchronizes-with (dispatch, host<->device)
// syncbar:   barriers with the same logical barrier resource   [optional]

// Tags (expected from the front-end):
// THREAD, WAVE, WG, CLUSTER, AGENT, SYS: thread, wavefront, workgroup, cluster, agent, system scopes

// AV: @llvm.amdgcn.av.store.*  (non-atomic store-available)
// VIS: @llvm.amdgcn.av.load.*   (non-atomic load-visible)
// NOAV: !mmra !{!"amdgcn-av", !"none"}
// VOL: `volatile` access

// https://llvm.org/docs/AMDGPUUsage.html#address-spaces
// FLAT: flat, addrspace(0)
// LDS: Local Data Share, addrspace(3), or addrspace(0) resolving to addrspace(3)

(*******************)
(*   Auxiliaries   *)
(*******************)

(* Scope lattice: GEx = "scope is x or wider" *)
let GESYS     = SYS
let GEAGENT   = SYS | AGENT
let GECLUSTER = SYS | AGENT | CLUSTER
let GEWG      = SYS | AGENT | CLUSTER | WG
let GEWAVE    = SYS | AGENT | CLUSTER | WG | WAVE
let GETHREAD  = SYS | AGENT | CLUSTER | WG | WAVE | THREAD

(* Inclusive scopes: each operation's scope instance contains the other *)
let inscope = (GESYS * GESYS) |
              (sagent   & (GEAGENT   * GEAGENT))   |
              (scluster & (GECLUSTER * GECLUSTER)) |
              (swg      & (GEWG      * GEWG))      |
              (swave    & (GEWAVE    * GEWAVE))    |
              (int      & (GETHREAD  * GETHREAD))

// NOAV does NOT affect the operation's own access (MakePointerAvailable / MakePointerVisible survive); it only kills MakeAvailable / MakeVisible.
// Only synchronizing operations qualify here, so `volatile` never appears.
let MAV  = ((F | ATOM) & REL) \ NOAV      // make-available
let MVIS = ((F | ATOM) & ACQ) \ NOAV      // make-visible

(* Store-available / load-visible have three sources, with three different  *)
(* rules for the EFFECTIVE av/vis scope -- which is not in general the      *)
(* operation's syncscope:                                                   *)
//   *SCOPED : atomics and the av.store/av.load intrinsics -> syncscope / !scope
//   *LDS    : any addrspace(3) access                     -> workgroup
//   *VOL    : non-atomic volatile on global/generic       -> system
// A volatile ATOMIC access is not widened: it falls into *SCOPED and keeps
// its syncscope, which is why *VOL subtracts ATOM.
let SAVSCOPED = ((W & ATOM) | AV) \ LDS
let SAVLDS    = W & LDS
let SAVVOL    = (((W & VOL) \ ATOM) \ AV) \ LDS
let SAV = SAVSCOPED | SAVLDS | SAVVOL      // store-available

let LVISSCOPED = ((R & ATOM) | VIS) \ LDS
let LVISLDS    = R & LDS
let LVISVOL    = (((R & VOL) \ ATOM) \ VIS) \ LDS
let LVIS = LVISSCOPED | LVISLDS | LVISVOL  // load-visible

(* The syncscope-driven source is filtered by the GE* lattice; the LDS and  *)
(* volatile sources are injected at their fixed effective level instead.    *)
let SAVSYS     = (SAVSCOPED & GESYS)     | SAVVOL
let SAVAGENT   = (SAVSCOPED & GEAGENT)   | SAVVOL
let SAVCLUSTER = (SAVSCOPED & GECLUSTER) | SAVVOL
let SAVWG      = (SAVSCOPED & GEWG)      | SAVVOL | SAVLDS
let SAVWAVE    = (SAVSCOPED & GEWAVE)    | SAVVOL | SAVLDS

let LVISSYS     = (LVISSCOPED & GESYS)     | LVISVOL
let LVISAGENT   = (LVISSCOPED & GEAGENT)   | LVISVOL
let LVISCLUSTER = (LVISSCOPED & GECLUSTER) | LVISVOL
let LVISWG      = (LVISSCOPED & GEWG)      | LVISVOL | LVISLDS
let LVISWAVE    = (LVISSCOPED & GEWAVE)    | LVISVOL | LVISLDS

let AVSYS     = (MAV & GESYS)     | SAVSYS
let AVAGENT   = (MAV & GEAGENT)   | SAVAGENT
let AVCLUSTER = (MAV & GECLUSTER) | SAVCLUSTER
let AVWG      = (MAV & GEWG)      | SAVWG
let AVWAVE    = (MAV & GEWAVE)    | SAVWAVE

let VISSYS     = (MVIS & GESYS)     | LVISSYS
let VISAGENT   = (MVIS & GEAGENT)   | LVISAGENT
let VISCLUSTER = (MVIS & GECLUSTER) | LVISCLUSTER
let VISWG      = (MVIS & GEWG)      | LVISWG
let VISWAVE    = (MVIS & GEWAVE)    | LVISWAVE

// Verdicts involving unresolved flat volatile accesses are reading-dependent.
// See NOTE 9.
flag ~empty [(FLAT \ LDS) & VOL] as unresolved-volatile-flat

(* Scoped modification order: no global co across non-inclusive scopes *)
let mutordatom = (loc & inscope & (ATOM * ATOM)) \ id
let asmo = co & mutordatom

let imm(r) = r \ (r; r+)
let rs     = [REL & ATOM]; (imm(asmo); [RMW])*
let hypors = [W & ATOM];   (imm(asmo); [RMW])*

(* synchronizes-with. No storage-class crossing: plain po replaces          *)
(* Vulkan's posctosem / posemtosc.                                          *)
let sw = inscope & (
    ([REL & ATOM]; rs; (rf & mutordatom); [ACQ & ATOM]) |                                       // atomic->atomic
    ([REL & F]; po; [ATOM & W]; hypors; (rf & mutordatom); [ACQ & ATOM]) |                      // fence->atomic
    ([REL & ATOM]; rs; (rf & mutordatom); [ATOM & R]; po; [ACQ & F]) |                          // atomic->fence
    ([REL & F]; po; [ATOM & W]; hypors; (rf & mutordatom); [ATOM & R]; po; [ACQ & F]) |         // fence->fence
    ([REL & F]; po?; [CBAR]; ((syncbar & inscope) \ id); [CBAR]; po?; [ACQ & F])                // fence->s.barrier->fence
)

(* happens-before. Structurally unchanged from the LLVM memory model, and   *)
(* unaffected by NOAV.                                                      *)
let hb = (po | ssw | sw)+

(**********************************)
(*  Availability / Visibility     *)
(**********************************)

let E = (M | F | CBAR) \ IW
let chains = E * E

(* Which pairs may be linked in a chain. No storage-class matching needed;  *)
(* pointer-level ops still have to concern the same address.                *)
let avvisSet = [SAV | LVIS]; loc
let avvisinc = (E * MAV) | (MVIS * E) | avvisSet | avvisSet^-1

(* Availability expands outwards into progressively larger scopes *)
let avwave    = [AVWAVE]
let avwg      = (chains & (avwave; (hb & swave & avvisinc))?); [AVWG]
let avcluster = (chains & ((avwave; (hb & swave & avvisinc))?;
                           (avwg;   (hb & swg   & avvisinc))?)); [AVCLUSTER]
let avagent   = (chains & ((avwave;    (hb & swave    & avvisinc))?;
                           (avwg;      (hb & swg      & avvisinc))?;
                           (avcluster; (hb & scluster & avvisinc))?)); [AVAGENT]
let avsys     = (chains & ((avwave;    (hb & swave    & avvisinc))?;
                           (avwg;      (hb & swg      & avvisinc))?;
                           (avcluster; (hb & scluster & avvisinc))?;
                           (avagent;   (hb & sagent   & avvisinc))?)); [AVSYS]

(* Visibility narrows inwards towards the observer *)
let viswave    = [VISWAVE]
let viswg      = [VISWG]; (chains & ((hb & swave & avvisinc); viswave)?)
let viscluster = [VISCLUSTER]; (chains & (((hb & swg   & avvisinc); viswg)?;
                                          ((hb & swave & avvisinc); viswave)?))
let visagent   = [VISAGENT]; (chains & (((hb & scluster & avvisinc); viscluster)?;
                                        ((hb & swg      & avvisinc); viswg)?;
                                        ((hb & swave    & avvisinc); viswave)?))
let vissys     = [VISSYS]; (chains & (((hb & sagent   & avvisinc); visagent)?;
                                      ((hb & scluster & avvisinc); viscluster)?;
                                      ((hb & swg      & avvisinc); viswg)?;
                                      ((hb & swave    & avvisinc); viswave)?))

(**********************************)
(*         Location Order         *)
(**********************************)

let locord = loc & (
    ([W]; po; [M]) |                                                                             // W before any access, program order
    ([R]; hb; [M]) |                                                                             // RaR, WaR
    ([W]; (po? & avvisinc); avwave;    (hb & swave);                                     [W]) |  // WaW  (wavefront)
    ([W]; (po? & avvisinc); avwave;    (hb & swave);    viswave;    (po? & avvisinc);    [R]) |  // RaW  (wavefront)
    ([W]; (po? & avvisinc); avwg;      (hb & swg);                                       [W]) |  // WaW  (workgroup)
    ([W]; (po? & avvisinc); avwg;      (hb & swg);      viswg;      (po? & avvisinc);    [R]) |  // RaW  (workgroup)
    ([W]; (po? & avvisinc); avcluster; (hb & scluster);                                  [W]) |  // WaW  (cluster)
    ([W]; (po? & avvisinc); avcluster; (hb & scluster); viscluster; (po? & avvisinc);    [R]) |  // RaW  (cluster)
    ([W]; (po? & avvisinc); avagent;   (hb & sagent);                                    [W]) |  // WaW  (agent)
    ([W]; (po? & avvisinc); avagent;   (hb & sagent);   visagent;   (po? & avvisinc);    [R]) |  // RaW  (agent)
    ([W]; (po? & avvisinc); avsys;     hb;                                               [W]) |  // WaW  (system)
    ([W]; (po? & avvisinc); avsys;     hb;              vissys;     (po? & avvisinc);    [R])    // RaW  (system)
)

(* from-read over scoped modification order, as in vulkan.cat *)
let fr = ((rf & locord)^-1 ; (W * W) & locord) | (rf^-1; asmo) | (([IW]; rf)^-1; ((loc; [W]) \ id))
let fre = fr & ext

(***********************)
(* Memory Model Axioms *)
(***********************)

acyclic (locord | rf | fr | asmo) as consistency-cycle

// "If W1 is location-ordered before W2, and W2 before R, then R may not see W1."
// Stated for all reads in the AMDGPU doc; restrict to [R \ ATOM] if this
// turns out to over-constrain scoped atomics.
empty rf & (([W]; locord); ([W]; locord)+) as consistency-rf

empty rmw & (fre; (asmo & ext)) as atomic

(*********************************)
(* Undefined values (not races)  *)
(*********************************)

// AMDGPU yields `undef` rather than UB: a read that may see a write which is
// not location-ordered before it returns undef.
let pair_with_write = ((W * W) | (W * R) | (R * W)) \ ((IW * _) | (_ * IW))
let undefval = loc & (pair_with_write \ mutordatom \ id \ (locord | locord^-1))
flag ~empty undefval as undef-value

(*********************************************************************)
(* NOTES: what changed relative to vulkan.cat                        *)
(*                                                                   *)
(* 1. Storage classes removed. SC0..SC3 / SEMSC0..SEMSC3 and the 15  *)
(*    ithbsemsc instantiations collapse into a single `hb`, because  *)
(*    AMDGPU ordering operations affect all address spaces (the      *)
(*    explicit TODO in the LLVM doc). This is by far the largest cut *)
(*    in state space, and the main place to re-expand if the         *)
(*    address-space parameter ever lands upstream.                   *)
(*                                                                   *)
(* 2. PRIV / NONPRIV removed. AMDGPU has no NonPrivatePointer: any   *)
(*    write can be made available by a later make-available op, so   *)
(*    every [W \ PRIV] becomes [W].                                  *)
(*                                                                   *)
(* 3. Opt-out instead of opt-in. MAV / MVIS are derived from plain   *)
(*    REL / ACQ minus NOAV, rather than requiring an explicit        *)
(*    MakeAvailable / MakeVisible tag. NOAV is subtractive only in   *)
(*    MAV / MVIS; SAV / LVIS and `hb` are untouched by it.           *)
(*                                                                   *)
(* 4. Scope levels: SG/WG/QF/DV -> WAVE/WG/CLUSTER/AGENT/SYS, plus   *)
(*    THREAD in `inscope` only.                                      *)
(*                                                                   *)
(* 5. No device/host domain. AVDEVICE / VISDEVICE and the avdv/visdv *)
(*    locord cases are gone; SYS is the ceiling.                     *)
(*                                                                   *)
(* 6. Effective av/vis scope is decoupled from syncscope in two      *)
(*    places, which is why SAV*/LVIS* are built per level rather     *)
(*    than filtered through GE* as one set: addrspace(3) accesses    *)
(*    are SAV/LVIS at WG scope regardless of syncscope, and          *)
(*    non-atomic volatile accesses are SAV/LVIS at system scope.     *)
(*    Neither feeds the levels above its own.                        *)
(*                                                                   *)
(* 7. vloc dropped. The AMDGPU model does not distinguish virtual    *)
(*    from physical locations; add `vloc` back if you model          *)
(*    aliasing address spaces.                                       *)
(*                                                                   *)
(* 8. THREAD is not chained. A singlethread-scoped availability op   *)
(*    is subsumed by the ([W]; po; [M]) case of locord, so adding a  *)
(*    sixth chain level would only cost solver time. Likewise, drop  *)
(*    the CLUSTER level entirely for pre-gfx12 targets: that removes *)
(*    one link from every chain.                                     *)
(*                                                                   *)
(* 9. volatile ambiguity. The spec grants system scope to            *)
(*    addrspace(0) volatile accesses, but grants workgroup scope to  *)
(*    addrspace(0) resolving to addrspace(3) in the earlier section, *)
(*    without stating which wins. We take the resolved space as      *)
(*    authoritative: the LDS tag already absorbs resolved flat, and  *)
(*    SAVVOL/LVISVOL subtract it. For flat accesses the front-end    *)
(*    cannot resolve, this file grants system scope (the FIDELITY    *)
(*    reading); the SOUND reading is workgroup, since over-granting  *)
(*    availability admits broken executions. Run both and report     *)
(*    disagreements -- the flag above marks the affected tests.      *)
(*                                                                   *)
(* 10. volatile makes this model STRONGER than generic LLVM, not     *)
(*    weaker: LangRef leaves volatile's inter-thread behaviour       *)
(*    target-dependent and AMDGPU pins it down. Every other delta    *)
(*    in this file is a relaxation, so "LLVM subset of AMDGPU subset *)
(*    of Vulkan" does not hold without qualification.                *)
(*********************************************************************)