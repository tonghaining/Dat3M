PTX RMW-release-sequence
{
x=0;
y=0;
P1:r0=0;
P2:r1=0;
P2:r2=0;
}
 P0@cta 0,gpu 0                 | P1@cta 1,gpu 0                  | P2@cta 2,gpu 0            ;
 st.release.gpu x, 1            | atom.relaxed.gpu.add r0, x, 1   | ld.acquire.gpu r1, x      ;
 st.release.gpu y, 1            |                                 | ld.relaxed.gpu r2, y      ;
~exists
(P2:r1 == 2 /\ P2:r2 == 0)