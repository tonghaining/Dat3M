PTX W+RWC-fence-sc-cta
// Figure 6 of https://dl.acm.org/doi/10.1145/3062341.3062352
{
x=0;
y=0;
z=0;
P1:r0=0;
P1:r2=0;
P2:r1=0;
}
P0@cta 0,gpu 0         | P1@cta 0,gpu 0         | P2@cta 0,gpu 0        ;
st.relaxed.cta x, 1    | ld.acquire.cta r0, z   | st.relaxed.cta y, 1   ;
st.release.cta z, 1    | fence.sc.cta           | fence.sc.cta          ;
                       | ld.relaxed.cta r2, y   | ld.relaxed.cta r1, x  ;
~exists
(P1:r0==1 /\ P2:r1==0 /\ P1:r2==0)