PTX MP-cas-cross-space-cta
{
x=0;
y=0;
P0:r0=0;
P1:r1=0;
}
 P0@cta 0,gpu 0                 | P1@cta 0,gpu 0                   ;
 st.weak x, 1                   | atom.relaxed.cta.cas r1, y, 1, 0 ;
 fence.acq_rel.cta              | fence.acq_rel.cta                ;
 atom.relaxed.cta.exch r0, y, 1 | ld.weak r2, x   ;
~exists
(P1:r1 == 1 /\ P1:r2 == 0)