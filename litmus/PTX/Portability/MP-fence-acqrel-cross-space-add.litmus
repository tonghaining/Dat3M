PTX Fence-acq-rel-MP
{
x=0;
y=0;
P0:r0=0;
P0:r1=0;
P1:r2=0;
P1:r3=0;
}
 P0@cta 0,gpu 0                | P1@cta 0,gpu 0                ;
 atom.relaxed.cta.add r0, x, 1 | atom.relaxed.cta.add r2, y, 0 ;
 fence.acq_rel.cta             | fence.acq_rel.cta             ;
 atom.relaxed.cta.add r1, y, 1 | atom.relaxed.cta.add r3, x, 0 ;

