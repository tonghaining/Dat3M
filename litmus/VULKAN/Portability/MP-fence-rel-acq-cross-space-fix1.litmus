Vulkan MP-fence-rel-acq-cross-space
{
P1:r0=0;
P1:r1=0;
x=0;
y=0;
}

P0@sg 0, wg 0, qf 0               | P1@sg 1, wg 0, qf 0                ;
st.nonpriv.sc1 x, 1               | ld.atom.wg.sc0 r0, y               ;
membar.rel.wg.semsc0.semsc1.semav | membar.acq.wg.semsc0.semsc1.semvis ;
st.atom.wg.sc0 y, 1               | ld.nonpriv.sc1 r1, x               ;

filter (P1:r0 == 1)
~exists (P1:r1 == 0)
