Vulkan MP-rel-acq-local
{
P1:r0=0;
P1:r1=0;
x=0;
y=0;
}

P0@sg 0, wg 0, qf 0                  | P1@sg 1, wg 0, qf 0                    ;
st.nonpriv.sc1 x, 1                  | ld.atom.acq.wg.sc1.semsc1.semvis r0, y ;
st.atom.rel.wg.sc1.semsc1.semav y, 1 | ld.nonpriv.sc1 r1, x                   ;

filter (P1:r0 == 1)
~exists (P1:r1 == 0)
