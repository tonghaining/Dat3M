x=0;
y=0;
}
 P0@sg 0, wg 0, qf 0             | P1@sg 1,wg 0, qf 0              ;
 st.atom.rel.wg.sc0.semsc0 x, 1  | st.atom.rel.wg.sc0.semsc0 y, 1  ;
