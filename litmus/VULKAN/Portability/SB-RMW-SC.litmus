Vulkan RMW
{
x=0;
y=0;
P0:r0=0;
P0:r1=0;
P1:r2=0;
P1:r3=0;
}
 P0@sg 0, wg 0, qf 0                          | P1@sg 0, wg 0, qf 0                         ;
 rmw.atom.acq_rel.dv.sc0.semsc0.add r0, x, 1  | rmw.atom.acq_rel.dv.sc0.semsc0.add r2, y, 1 ;
 rmw.atom.acq_rel.dv.sc0.semsc0.add r1, y, 1  | rmw.atom.acq_rel.dv.sc0.semsc0.add r3, x, 1 ;

~exists (P0:r1==0 /\ P1:r3==0)