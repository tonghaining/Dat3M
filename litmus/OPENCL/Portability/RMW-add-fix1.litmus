OPENCL RMW-add
{
[x] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x) {
 atomic_store_explicit(x, 1, memory_order_relaxed, memory_scope_all_svm_devices);
 int r0 = atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_all_svm_devices);
}

P1@wg 1, dev 0 (global atomic_int* x) {
  int r1 = atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_all_svm_devices);
}

~exists
(P0:r0 == 1 /\ P1:r1 == 1)