OPENCL MP-cas-cross-space-cta-fix3
{
[x] = 0;
[y] = 0;
[expected] = 1;
}

P0@wg 0, dev 0 (local int* x, global atomic_int* y, global int* expected) {
 *x = 1;
 int r0 = atomic_exchange_explicit(y, 1, memory_order_relaxed, memory_scope_work_group);
 atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE | CLK_LOCAL_MEM_FENCE, memory_order_acq_rel, memory_scope_work_group);
}

P1@wg 0, dev 0 (local int* x, global atomic_int* y, global int* expected) {
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE | CLK_LOCAL_MEM_FENCE, memory_order_acq_rel, memory_scope_work_group);
  int t = atomic_compare_exchange_strong_explicit(y, expected, 0, memory_order_relaxed, memory_order_relaxed, memory_scope_work_group);
  if (t) {
    int r1 = *x;
  }
}

~exists
(P1:t == 1 /\ P1:r1 == 0)