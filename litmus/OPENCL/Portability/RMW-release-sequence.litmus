OPENCL RMW-release-sequence
{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, global atomic_int* y) {
 atomic_store_explicit(x, 1, memory_order_release, memory_scope_device);
 atomic_store_explicit(y, 1, memory_order_release, memory_scope_device);
}

P1@wg 1, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r0 = atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_device);
}

P2@wg 2, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r1 = atomic_load_explicit(x, memory_order_acquire, memory_scope_device);
  int r2 = atomic_load_explicit(y, memory_order_relaxed, memory_scope_device);
}

~exists
(P2:r1 == 2 /\ P2:r2 == 0)