OPENCL MP

{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global int* x, local atomic_int* y) {
  *x = 1;
  atomic_work_item_fence(CLK_LOCAL_MEM_FENCE, memory_order_release, memory_scope_work_group);
  atomic_store_explicit(y, 1, memory_order_release, memory_scope_work_group);
}

P1@wg 0, dev 0 (global int* x, local atomic_int* y) {
   while(atomic_load_explicit(y, memory_order_acquire, memory_scope_work_group) == 0) {}
   atomic_work_item_fence(CLK_LOCAL_MEM_FENCE, memory_order_acquire, memory_scope_work_group);
   int r0 = *x;
}

~exists
(P1:r0 == 0)