OPENCL RMW-add-cta-gpu-local-fix2
{
[x] = 0;
}

P0@wg 0, dev 0 (local atomic_int* x) {
 atomic_store_explicit(x, 1, memory_order_relaxed, memory_scope_work_group);
 int r0 = atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_work_group);
}

P1@wg 0, dev 0 (local atomic_int* x) {
  int r1 = atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_work_group);
}

~exists
(P0:r0 == 1 /\ P1:r1 == 1)