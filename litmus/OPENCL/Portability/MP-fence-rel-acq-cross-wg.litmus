OPENCL MP-fence-rel-acq-cross-wg

{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global int* x, global atomic_int* y) {
  *x = 1;
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_release, memory_scope_device);
  atomic_store_explicit(y, 1, memory_order_relaxed, memory_scope_device);
}

P1@wg 1, dev 0 (global int* x, global atomic_int* y) {
  int r0 = atomic_load_explicit(y, memory_order_relaxed, memory_scope_device);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acquire, memory_scope_device);
  int r1 = *x;
}

filter (P1:r0 == 1)
~exists (P1:r1 == 0)
