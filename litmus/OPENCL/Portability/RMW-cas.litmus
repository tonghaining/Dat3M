OPENCL RMW-release-sequence
{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, global atomic_int* y) {
 atomic_store_explicit(y, 1, memory_order_release, memory_scope_device);
 int r0 = atomic_compare_exchange_strong_explicit(x, 0, 1, memory_order_release, memory_order_release);
}

P1@wg 1, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r1 = atomic_compare_exchange_strong_explicit(x, 1, 2, memory_order_relaxed, memory_order_relaxed);
}

P2@wg 2, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r2 = atomic_compare_exchange_strong_explicit(x, 1, 3, memory_order_acquire, memory_order_acquire);
  int r3 = atomic_load_explicit(y, memory_order_relaxed, memory_scope_device);
}

~exists
(P2:r3 == 0)