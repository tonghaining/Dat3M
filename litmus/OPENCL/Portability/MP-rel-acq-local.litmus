OPENCL MP-rel-acq-local

{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (local int* x, local atomic_int* y) {
  *x = 1;
  atomic_store_explicit(y, 1, memory_order_release, memory_scope_work_group);
}

P1@wg 0, dev 0 (local int* x, local atomic_int* y) {
  int r0 = atomic_load_explicit(y, memory_order_acquire, memory_scope_work_group);
  int r1 = *x;
}

filter (P1:r0 == 1)
~exists (P1:r1 == 0)
