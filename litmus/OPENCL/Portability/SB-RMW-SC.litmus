OPENCL SB-RMW-SC
{
  [x] = 0;
  [y] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r0 = atomic_fetch_add_explicit(x, 1, memory_order_seq_cst, memory_scope_device);
  int r1 = atomic_fetch_add_explicit(y, 0, memory_order_seq_cst, memory_scope_device);
}

P1@wg 1, dev 0 (global atomic_int* x, global atomic_int* y) {
  int r2 = atomic_fetch_add_explicit(y, 1, memory_order_seq_cst, memory_scope_device);
  int r3 = atomic_fetch_add_explicit(x, 0, memory_order_seq_cst, memory_scope_device);
}

~exists (P0:r1==0 /\ P1:r3==0)