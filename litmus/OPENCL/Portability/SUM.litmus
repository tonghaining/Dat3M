OPENCL SUM

(*
 * https://docs.nvidia.com/cuda/cuda-programming-guide/05-appendices/cpp-language-extensions.html#memory-fence-functions
 *)

{
[x] = 0;
[count] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, global atomic_int* y, local atomic_int* count) {
 atomic_store_explicit(x, 1, memory_order_relaxed, memory_scope_device);
 atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE|CLK_LOCAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
 int r0 = atomic_fetch_add_explicit(count, 1, memory_order_relaxed, memory_scope_device);
}

P1@wg 1, dev 0 (global atomic_int* x, global atomic_int* y, local atomic_int* count) {
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE|CLK_LOCAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
  int r1 = atomic_fetch_add_explicit(count, 1, memory_order_relaxed, memory_scope_device);
  int r2 = atomic_load_explicit(x, memory_order_relaxed, memory_scope_device);
}

~exists
(P1:r1 == 1 /\ P1:r2 == 0)