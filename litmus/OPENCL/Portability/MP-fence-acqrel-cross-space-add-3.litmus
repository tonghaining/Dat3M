OPENCL Fence-acq-rel-MP
{
[x] = 0;
[y] = 0;
[z] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, local atomic_int* y, global atomic_int* z) {
 atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_work_group);
 atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acq_rel, memory_scope_work_group);
 atomic_fetch_add_explicit(y, 1, memory_order_relaxed, memory_scope_work_group);
}

P1@wg 0, dev 0 (global atomic_int* x, local atomic_int* y, global atomic_int* z) {
  int r2 = atomic_fetch_add_explicit(y, 0, memory_order_relaxed, memory_scope_work_group);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acq_rel, memory_scope_work_group);
  int r3 = atomic_fetch_add_explicit(z, 1, memory_order_relaxed, memory_scope_work_group);
}

P2@wg 0, dev 0 (global atomic_int* x, local atomic_int* y, global atomic_int* z) {
  int r4 = atomic_fetch_add_explicit(z, 0, memory_order_relaxed, memory_scope_work_group);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_acq_rel, memory_scope_work_group);
  int r5 = atomic_fetch_add_explicit(x, 0, memory_order_relaxed, memory_scope_work_group);
}

~exists
(P1:r2 == 1 /\ P2:r4 == 1 /\ P2:r5 == 0)
