OPENCL Fence-SC-MP
{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, local atomic_int* y) {
 atomic_fetch_add_explicit(x, 1, memory_order_relaxed, memory_scope_device);
 atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
 atomic_fetch_add_explicit(y, 1, memory_order_relaxed, memory_scope_device);
}

P1@wg 0, dev 0 (global atomic_int* x, local atomic_int* y) {
  int r2 = atomic_fetch_add_explicit(y, 0, memory_order_relaxed, memory_scope_device);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
  int r3 = atomic_fetch_add_explicit(x, 0, memory_order_relaxed, memory_scope_device);
}

~exists
(P1:r2 == 1 /\ P1:r3 == 0)