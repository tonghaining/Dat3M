OPENCL MP-rel-acq-cross-space-dev-fix5

{
[x] = 0;
[y] = 0;
}

P0@wg 0, dev 0 (global int* x, local atomic_int* y) {
  *x = 1;
  atomic_store_explicit(y, 1, memory_order_release, memory_scope_device);
  B1: barrier(CLK_GLOBAL_MEM_FENCE);
}

P1@wg 0, dev 0 (global int* x, local atomic_int* y) {
  while(atomic_load_explicit(y, memory_order_acquire, memory_scope_device) == 0) {}
  B1: barrier(CLK_GLOBAL_MEM_FENCE);
  int r0 = *x;
}

~exists
(P1:r0 == 0)