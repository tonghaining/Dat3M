OPENCL Fence-SC-W+RWC
// Figure 6 of https://dl.acm.org/doi/10.1145/3062341.3062352
// Upgrade relaxed producer to SC
{
[x] = 0;
[y] = 0;
[z] = 0;
}

P0@wg 0, dev 0 (global atomic_int* x, global atomic_int* y, global atomic_int* z) {
 atomic_store_explicit(x, 1, memory_order_seq_cst, memory_scope_device);
 atomic_store_explicit(z, 1, memory_order_release, memory_scope_device);
}

P1@wg 1, dev 0 (global atomic_int* x, global atomic_int* y, global atomic_int* z) {
  int r0 = atomic_load_explicit(z, memory_order_acquire, memory_scope_device);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
  int r2 = atomic_load_explicit(y, memory_order_relaxed, memory_scope_device);
}

P2@wg 2, dev 0 (global atomic_int* x, global atomic_int* y, global atomic_int* z) {
  atomic_store_explicit(y, 1, memory_order_seq_cst, memory_scope_device);
  atomic_work_item_fence(CLK_GLOBAL_MEM_FENCE, memory_order_seq_cst, memory_scope_device);
  int r1 = atomic_load_explicit(x, memory_order_relaxed, memory_scope_device);
}

~exists
(P1:r0==1 /\ P2:r1==0 /\ P1:r2==0)